# Discord Bot Token（必填）
# 从 https://discord.com/developers/applications 获取
# ⚠️ 重置后的 token 填在这里，不要填已经泄露的旧 token！
DISCORD_BOT_TOKEN=你的Bot_Token填在这里

# 领取单蓝链的公网根地址（不要末尾斜杠）
# bot-hosting.net：面板「域名」页的规范网址，例如
# PUBLIC_BASE_URL=https://v4fbz80a0x.apps.bot-hosting.cloud
PUBLIC_BASE_URL=

# bot-hosting.net 面板写的应用程序端口（你这边是 25243）
# 不填则优先用 SERVER_PORT，再退回 PORT，最后 8080
# PORT=25243
#
# 贝多芬点唱机语音房：频道名含「音乐世家」
# 托管环境需要 ffmpeg，YouTube / SoundCloud 链接靠 yt-dlp 解析后在语音房播放